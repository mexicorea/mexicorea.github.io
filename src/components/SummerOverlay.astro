---
interface Props {
  src?: string;
}

const { src = '/leaves-loop-soft2.mp4' } = Astro.props;
---

<video
  id="summer-overlay-video"
  class="summer-overlay"
  src={src}
  autoplay
  loop
  muted
  playsinline
  webkit-playsinline="true"
  preload="auto"
  aria-hidden="true"
></video>

<script is:inline>
  (() => {
    const overlay = document.getElementById('summer-overlay-video');

    if (!(overlay instanceof HTMLVideoElement)) {
      return;
    }

    const ensurePlayback = () => {
      overlay.defaultMuted = true;
      overlay.muted = true;
      overlay.loop = true;
      overlay.playsInline = true;
      overlay.play().catch(() => {});
    };

    ensurePlayback();
    overlay.addEventListener('loadeddata', ensurePlayback);
    overlay.addEventListener('canplay', ensurePlayback);
    overlay.addEventListener('ended', () => {
      overlay.currentTime = 0;
      ensurePlayback();
    });

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        ensurePlayback();
      }
    });

    window.addEventListener('pageshow', ensurePlayback);
  })();
</script>

<style>
  .summer-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.18;
    z-index: 32;
    filter: saturate(0.88) contrast(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    .summer-overlay {
      display: none;
    }
  }
</style>
