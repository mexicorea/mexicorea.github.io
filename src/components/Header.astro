---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav>
		<a href="/" class="site-branding">
			<span class="sr-only">{SITE_TITLE}</span>
			<pre class="ascii-brand" aria-hidden="true">███╗   ███╗███████╗██╗  ██╗██╗ ██████╗ ██████╗ ██████╗ ███████╗ █████╗ 
████╗ ████║██╔════╝╚██╗██╔╝██║██╔════╝██╔═══██╗██╔══██╗██╔════╝██╔══██╗
██╔████╔██║█████╗   ╚███╔╝ ██║██║     ██║   ██║██████╔╝█████╗  ███████║
██║╚██╔╝██║██╔══╝   ██╔██╗ ██║██║     ██║   ██║██╔══██╗██╔══╝  ██╔══██║
██║ ╚═╝ ██║███████╗██╔╝ ██╗██║╚██████╗╚██████╔╝██║  ██║███████╗██║  ██║
╚═╝     ╚═╝╚══════╝╚═╝  ╚═╝╚═╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝</pre>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">blog</HeaderLink>
			<HeaderLink href="/gallery">gallery</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</div>
		<!-- social-links hidden for now
		<div class="social-links">
			...
		</div>
		-->
	</nav>
</header>
<style>
	.site-header {
		margin: 0;
		padding: 0 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
	}
	.site-branding {
		justify-self: start;
		display: block;
		align-items: center;
		text-decoration: none;
		color: rgb(var(--black));
		padding: 0;
		height: 36px;
		width: min(42vw, 300px);
		max-width: min(42vw, 300px);
		overflow: hidden;
		position: relative;
	}
	.site-branding:hover {
		text-decoration: none;
	}
	.ascii-brand {
		margin: 0;
		color: var(--accent-dark);
		font-family:
			"IBM Plex Mono",
			"Fira Code",
			"JetBrains Mono",
			"SFMono-Regular",
			Menlo,
			Monaco,
			Consolas,
			"Liberation Mono",
			"Courier New",
			monospace;
		font-size: 1rem;
		line-height: 1;
		letter-spacing: 0;
		white-space: pre;
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%) scale(0.34);
		transform-origin: left center;
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 60px;
	}
	.internal-links {
		display: flex;
		gap: 2em;
		justify-self: center;
	}
	.internal-links a {
		font-style: normal;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.site-branding {
			width: min(52vw, 220px);
			max-width: min(52vw, 220px);
		}
		.ascii-brand {
			transform: translateY(-50%) scale(0.27);
		}
		.social-links {
			display: none;
		}
		.internal-links {
			gap: 1em;
		}
	}
</style>
