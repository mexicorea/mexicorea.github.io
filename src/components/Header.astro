---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="site-branding">
			<img src="/mexicorea.png" alt="mexicorea" class="profile-pic" />
			<h2>{SITE_TITLE}</h2>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">/blog</HeaderLink>
			<HeaderLink href="/gallery">/gallery</HeaderLink>
			<HeaderLink href="/about">/about</HeaderLink>
		</div>
		<!-- social-links hidden for now
		<div class="social-links">
			...
		</div>
		-->
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
	}
	.site-branding {
		justify-self: start;
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		color: var(--black);
		padding: 1em 0.5em; /* Match original nav a padding */
	}
	.site-branding:hover {
		text-decoration: none;
	}
	img.profile-pic {
		width: 34px !important;
		max-width: 34px;
		height: 34px !important;
		border-radius: 50%;
		object-fit: cover;
		aspect-ratio: 1 / 1;
		flex-shrink: 0;
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
		color: inherit;
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 60px;
	}
	.internal-links {
		display: flex;
		gap: 2em;
	}
	.internal-links a {
		font-style: italic;
	}
	/* Removed generic nav a styling collision potential, kept specific ones or relied on inheritance */
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		.internal-links {
			gap: 1em;
		}
	}
</style>
